[
  {
    "label": "rx-tsc: type-check project",
    "command": "npx",
    "args": ["--no-install", "rx-tsc", "--noEmit"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "rx-tsc: type-check project (watch)",
    "command": "npx",
    "args": ["--no-install", "rx-tsc", "--noEmit", "--watch"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true
  }
]
